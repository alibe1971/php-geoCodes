#!/usr/bin/env php
<?php
declare(strict_types=1);

// ANSI color codes
define('COLOR_RED', "\033[31m");
define('COLOR_RESET', "\033[0m");

// Always use the same CLI that invoked this script
$phpBin    = PHP_BINARY;
$phpVersion= PHP_VERSION;

fwrite(STDOUT, "Using PHP CLI: {$phpBin} (version {$phpVersion})\n\n");

/**
 * Executes an external command and handles its output.
 *
 * @param string       $label       Descriptive label for the task
 * @param list<string> $cmd         Array of command and its arguments to execute
 * @param bool         $exitOnErr   If true, exits with code > 0 on error
 * @return string                    Combined stdout and stderr output
 */
function run(string $label, array $cmd, bool $exitOnErr = true): string {
    fwrite(STDOUT, "{$label}…\n");

    $proc = proc_open(
        $cmd,
        [
            ['pipe', 'r'],
            ['pipe', 'w'],
            ['pipe', 'w'],
        ],
        $pipes
    );

    if ($proc === false) {
        fwrite(STDERR, COLOR_RED . "Error: unable to open process for '{$label}'." . COLOR_RESET . "\n");
        exit(1);
    }

    // Ensure to PHPStan that $proc is a resource
    assert(is_resource($proc));

    $out  = stream_get_contents($pipes[1]);
    $err  = stream_get_contents($pipes[2]);
    $code = proc_close($proc);

    if ($exitOnErr && $code !== 0) {
        fwrite(STDERR, COLOR_RED . $out . $err . "\nError during stage: {$label}" . COLOR_RESET . "\n");
        exit(1);
    }

    fwrite(STDOUT, "{$label} completed.\n\n");
    return trim($out . $err);
}

// Change to project base directory (one level above 'dev')
$baseDirectory = dirname(__DIR__);
chdir($baseDirectory);

// 1) php-cbf (fix PSR-12)
run(
    '1) php-cbf (fix PSR-12)',
    [$phpBin, 'vendor/bin/phpcbf', '--standard=phpcs.xml']
);

// 2) phpcs (check PSR-12)
$snifferReport = run(
    '2) phpcs (check PSR-12)',
    [$phpBin, 'vendor/bin/phpcs', '--standard=phpcs.xml'],
    false
);
if ($snifferReport !== '') {
    fwrite(STDERR,
           COLOR_RED .
           "PSR-12 violations detected:\n" .
           $snifferReport .
           "\nPlease fix ERRORS and WARNINGS before proceeding." .
           COLOR_RESET .
           "\n"
    );
    exit(1);
}

// 3) phpstan analyse (static analysis)
run(
    '3) phpstan analyse',
    [$phpBin, 'vendor/bin/phpstan', 'analyse', '-c', 'phpstan.neon', '--memory-limit=1G']
);

// 4) phpunit tests (geoCodes)
run(
    '4) phpunit tests (geoCodes)',
    [$phpBin, 'vendor/bin/phpunit', '--testsuite', 'geoCodes', '--testdox']
);

fwrite(STDOUT,
       "🎉 All checks passed successfully.\n" .
       "You can now commit and push.\n"
);
exit(0);
