<?xml version="1.0"?>
<ruleset name="CustomRuleset">
    <rule ref="PSR12"/>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php,inc"/>
    <arg name="parallel" value="8"/>

    <exclude-pattern>*/src/Data/*</exclude-pattern>
    <exclude-pattern>*/tests/Fixtures/*</exclude-pattern>

</ruleset>

